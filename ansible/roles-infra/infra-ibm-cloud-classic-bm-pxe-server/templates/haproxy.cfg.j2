# HAProxy Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

global
    log         127.0.0.1 local2
    chroot      /var/lib/haproxy
    pidfile     /var/run/haproxy.pid
    maxconn     4000
    user        haproxy
    group       haproxy
    daemon

defaults
    mode                    tcp
    option                  tcplog
    log                     global
    option                  dontlognull
    timeout queue           1m
    timeout connect         10s
    timeout client          1m
    timeout server          1m
    timeout http-keep-alive 10s
    timeout check           10s
    maxconn                 3000

# Server-specific frontend/backend pairs  
{% for service in haproxy_services %}
frontend {{ bastion_hostname }}-{{ service.name }}-f
    bind {{ pxe_server_public_ip }}:{{ service.port }}
    mode tcp
    use_backend {{ baremetal_hostname }}-{{ service.name }}-b
backend {{ baremetal_hostname }}-{{ service.name }}-b
    server {{ baremetal_hostname }} {{ server_bmc_ip }}:{{ service.port }} check
{% endfor %}