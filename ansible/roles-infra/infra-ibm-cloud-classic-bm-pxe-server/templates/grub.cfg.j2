set timeout={{ grub_timeout }}

menuentry '{{ grub_menu_title }}' {
  linux {{ grub_kernel_path }} {{ grub_kernel_params }} inst.sshd inst.stage2=http://{{ pxe_server_private_ip }}/rhel10 inst.repo=http://{{ pxe_server_private_ip }}/rhel10 inst.ks=http://{{ pxe_server_private_ip }}/ks/rhel10-${net_default_mac}.ks
  initrd {{ grub_initrd_path }}
} 