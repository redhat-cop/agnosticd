---
# Network devices inventory for testing
all:
  children:
    routers:
      hosts:
        cisco-rtr-1:
          ansible_host: cisco-rtr-1.{{ guid }}.internal
          ansible_network_os: ios
          ansible_connection: ansible.netcommon.network_cli
          ansible_user: {{ student_name }}
          ansible_ssh_private_key_file: ~/.ssh/{{ env_authorized_key }}.pem
          ansible_become: yes
          ansible_become_method: enable
          ansible_become_password: {{ common_password }}
        cisco-rtr-2:
          ansible_host: cisco-rtr-2.{{ guid }}.internal
          ansible_network_os: ios
          ansible_connection: ansible.netcommon.network_cli
          ansible_user: {{ student_name }}
          ansible_ssh_private_key_file: ~/.ssh/{{ env_authorized_key }}.pem
          ansible_become: yes
          ansible_become_method: enable
          ansible_become_password: {{ common_password }}
