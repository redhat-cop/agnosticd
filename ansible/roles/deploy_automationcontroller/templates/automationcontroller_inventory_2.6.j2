{# AAP 2.5+ Flexible Inventory Template #}
{# Supports: Standalone, Multi-system, Containerized, EDA #}

{# ============ GROUPS ============ #}

{# Controller Group #}
{% if groups['automationcontroller'] is defined %}
[automationcontroller]
{% for host in groups['automationcontroller'] %}
{{ host }}
{% endfor %}
{% endif %}

{# Gateway Group - Use dedicated group or fall back to controller #}
{% if groups['automationgateway'] is defined %}
[automationgateway]
{% for host in groups['automationgateway'] %}
{{ host }}
{% endfor %}
{% elif groups['automationcontroller'] is defined %}
[automationgateway]
{% for host in groups['automationcontroller'] %}
{{ host }}
{% endfor %}
{% endif %}

{# Database Group #}
{% if groups['automationcontroller_database'] is defined %}
[database]
{{ groups['automationcontroller_database'][0] }}
{% elif groups['automationcontroller'] is defined %}
[database]
{% for host in groups['automationcontroller'] %}
{{ host }}
{% endfor %}
{% endif %}

{# Redis Group - Only define if dedicated redis hosts exist #}
{# For standalone, Redis is auto-installed on controller/gateway #}
{% if groups['redis'] is defined %}
[redis]
{% for host in groups['redis'] %}
{{ host }}
{% endfor %}
{% endif %}

{# Automation Hub Group #}
{% if groups['automationhub'] is defined %}
[automationhub]
{% for host in groups['automationhub'] %}
{{ host }}
{% endfor %}
{% endif %}

{# Event-Driven Ansible Group #}
{% if groups['automationeda'] is defined %}
[automationeda]
{% for host in groups['automationeda'] %}
{{ host }}
{% endfor %}
{% endif %}

{# Execution Nodes Group #}
{% if groups['execution_nodes'] is defined %}
[execution_nodes]
{% for host in groups['execution_nodes'] %}
{{ host }}
{% endfor %}

[automationcontroller:vars]
node_type={{ aap_deploy_controller_type | default('hybrid') }}
peers=execution_nodes
{% endif %}

{# ============ VARIABLES ============ #}

[all:vars]
ansible_become=true
ansible_become_method=sudo

# Redis Configuration
{% if groups['redis'] is defined %}
{% if (groups['redis'] | length) > 1 %}
redis_mode=cluster
{% else %}
redis_mode=standalone
{% endif %}
{% else %}
redis_mode=standalone
{% endif %}

# PostgreSQL Admin
postgresql_admin_username=postgres
postgresql_admin_password='{{ deploy_automationcontroller_admin_password }}'

{# ---- Containerized Installation ---- #}
{% if deploy_automationcontroller_bundle_install | default(false) | bool %}
bundle_install=true
bundle_dir={{ deploy_automationcontroller_bundle_dir }}
{% endif %}

{# ---- Controller Configuration ---- #}
controller_admin_password='{{ deploy_automationcontroller_admin_password }}'
{% if groups['automationcontroller_database'] is defined %}
controller_pg_host={{ groups['automationcontroller_database'][0] }}
{% else %}
controller_pg_host={{ groups['automationcontroller'][0] }}
{% endif %}
controller_pg_password='{{ deploy_automationcontroller_admin_password }}'

{# ---- Gateway Configuration ---- #}
gateway_admin_password='{{ deploy_automationcontroller_admin_password }}'
{% if groups['automationcontroller_database'] is defined %}
gateway_pg_host={{ groups['automationcontroller_database'][0] }}
{% elif groups['automationgateway'] is defined %}
gateway_pg_host={{ groups['automationgateway'][0] }}
{% else %}
gateway_pg_host={{ groups['automationcontroller'][0] }}
{% endif %}
gateway_pg_password='{{ deploy_automationcontroller_admin_password }}'

{# Gateway TLS (containerized) #}
{% if deploy_automationcontroller_gateway_tls_cert | default('') | length > 0 %}
gateway_tls_cert={{ deploy_automationcontroller_gateway_tls_cert }}
gateway_tls_key={{ deploy_automationcontroller_gateway_tls_key }}
{% endif %}

{# ---- Automation Hub Configuration ---- #}
{% if groups['automationhub'] is defined %}
hub_admin_password='{{ deploy_automationcontroller_admin_password }}'
{% if groups['automationcontroller_database'] is defined %}
hub_pg_host={{ groups['automationcontroller_database'][0] }}
{% else %}
hub_pg_host={{ groups['automationhub'][0] }}
{% endif %}
hub_pg_password='{{ deploy_automationcontroller_admin_password }}'
{% endif %}

{# ---- Event-Driven Ansible Configuration ---- #}
{% if groups['automationeda'] is defined %}
eda_admin_password='{{ deploy_automationcontroller_eda_admin_password | default(deploy_automationcontroller_admin_password) }}'
{% if groups['automationcontroller_database'] is defined %}
eda_pg_host={{ groups['automationcontroller_database'][0] }}
{% else %}
eda_pg_host={{ groups['automationeda'][0] }}
{% endif %}
eda_pg_password='{{ deploy_automationcontroller_admin_password }}'
{% endif %}

{# ---- Registry Configuration ---- #}
registry_url='{{ registry_url | default("registry.redhat.io") }}'
{% if registry_username | default('') | length > 0 %}
registry_username='{{ registry_username }}'
registry_password='{{ registry_password }}'
{% endif %}
