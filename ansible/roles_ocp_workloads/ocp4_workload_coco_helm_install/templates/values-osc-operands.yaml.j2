---
namespaceOverride: {{ ocp4_workload_coco_helm_install_osc_namespace }}
kataconfig:
  name: {{ ocp4_workload_coco_helm_install_kataconfig_name }}
  poolName: {{ ocp4_workload_coco_helm_install_kataconfig_pool }}
confidential:
  enabled: true
nodeSelector:
  labels:
    cloud:
      workerType: kataWorker
peerpods:
  enabled: true
  provider: azure
  providersConfigs:
    all:
      INITDATA: "{{ _coco_initdata }}"
      PEERPODS_LIMIT_PER_NODE: "{{ ocp4_workload_coco_helm_install_peerpods_limit_per_node }}"
      ROOT_VOLUME_SIZE: "{{ ocp4_workload_coco_helm_install_peerpod_root_volume_size }}"
      TAGS: "{{ ocp4_workload_coco_helm_install_peerpod_tags }}"
    azure:
      AZURE_REGION: "{{ _coco_location }}"
      AZURE_RESOURCE_GROUP: "{{ _coco_cluster_rg }}"
      AZURE_SUBNET_ID: "{{ _coco_subnet_id }}"
      AZURE_NSG_ID: "{{ _coco_nsg_id }}"
      AZURE_INSTANCE_SIZE: "{{ ocp4_workload_coco_helm_install_peerpod_instance_size }}"
      AZURE_INSTANCE_SIZES: "{{ ocp4_workload_coco_helm_install_peerpod_instance_sizes }}"
