---
namespaceOverride: {{ ocp4_workload_coco_helm_install_terminal_namespace }}
createNamespace: true
image: {{ ocp4_workload_coco_helm_install_terminal_image }}
bastion:
  host: {{ ocp4_workload_coco_helm_install_terminal_bastion_host }}
  port: {{ ocp4_workload_coco_helm_install_terminal_bastion_port | int }}
  user: {{ ocp4_workload_coco_helm_install_terminal_bastion_user }}
  password: {{ ocp4_workload_coco_helm_install_terminal_bastion_password | quote }}
route:
  domain: {{ _coco_cluster_domain }}
  hostPrefix: {{ ocp4_workload_coco_helm_install_terminal_host_prefix }}
  hostSuffix: {{ ocp4_workload_coco_helm_install_terminal_host_suffix }}
terminals:
{{ ocp4_workload_coco_helm_install_terminals | to_nice_yaml(indent=2) | indent(2, true) }}
