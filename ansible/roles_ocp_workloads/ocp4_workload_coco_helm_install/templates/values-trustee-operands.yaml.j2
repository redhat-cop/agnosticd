---
namespaceOverride: {{ ocp4_workload_coco_helm_install_trustee_namespace }}
profileType: {{ ocp4_workload_coco_helm_install_trustee_profile }}
clusterDomain: {{ _coco_cluster_domain }}
crossCluster:
  enabled: true
  route:
    name: {{ ocp4_workload_coco_helm_install_trustee_route_name }}
    # Empty host -> kbs-route-trustee-operator-system.<clusterDomain>,
    # which is also the dnsName of the KBS certificates.
    host: ""
    # Restricted profile: the KBS serves HTTPS with trustee-tls-cert, so the
    # router must pass TLS through (the trustee-operator would create the
    # same passthrough route if this chart did not).
    termination: passthrough
    insecurePolicy: None
certManager:
  enabled: true
securityPolicy:
  devhubPublicKey: |
{{ _coco_devhub_pub_key | indent(4, true) }}
  redhatPublicKey: |
{{ _coco_redhat_pub_key | indent(4, true) }}
