---
apiVersion: v1
kind: ConfigMap
metadata:
  name: rook-ceph-operator-config
  namespace: openshift-storage
data:
  CSI_ENABLE_CSIADDONS: "true"
  CSI_LOG_LEVEL: "5"
  CSI_PLUGIN_TOLERATIONS: |2-

    - key: node.ocs.openshift.io/storage
      operator: Equal
      value: "true"
      effect: NoSchedule
{% if ocp4_workload_external_odf_tolerations | length > 0 %}
    {{ ocp4_workload_external_odf_tolerations | to_yaml }}
{% endif %}
  CSI_PROVISIONER_TOLERATIONS: |2-

    - key: node.ocs.openshift.io/storage
      operator: Equal
      value: "true"
      effect: NoSchedule
{% if ocp4_workload_external_odf_tolerations | length > 0 %}
    {{ ocp4_workload_external_odf_tolerations | to_yaml }}
{% endif %}
