#!/bin/bash

# Create the database and admin user first (they don't exist yet when init scripts run)
psql -U postgres <<'EOSQL_SETUP'
CREATE DATABASE {{ shared_db_name }};
CREATE ROLE {{ shared_db_admin_user }} LOGIN PASSWORD '{{ shared_db_admin_password }}';
GRANT ALL PRIVILEGES ON DATABASE {{ shared_db_name }} TO {{ shared_db_admin_user }};
EOSQL_SETUP

# Now create per-user schemas in the target database
psql -U postgres -d {{ shared_db_name }} <<'EOSQL'
{% for user in im_users %}
-- Schema for {{ user.name }}
CREATE ROLE {{ user.name }} LOGIN PASSWORD '{{ user.password }}';
CREATE SCHEMA {{ user.name }} AUTHORIZATION {{ user.name }};

SET search_path TO {{ user.name }};

CREATE TABLE invoices (
    id CHARACTER VARYING NOT NULL,
    data TEXT NOT NULL,
    version INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (id)
);

CREATE OR REPLACE FUNCTION {{ user.name }}.increment_version()
RETURNS TRIGGER AS $$
BEGIN
    NEW.version := OLD.version + 1;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER invoices_version_trigger
    BEFORE UPDATE ON {{ user.name }}.invoices
    FOR EACH ROW
    EXECUTE FUNCTION {{ user.name }}.increment_version();

ALTER TABLE {{ user.name }}.invoices OWNER TO {{ user.name }};
ALTER FUNCTION {{ user.name }}.increment_version() OWNER TO {{ user.name }};

