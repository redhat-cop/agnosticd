---
apiVersion: v1
kind: ConfigMap
metadata:
  name: helpdesk-scripts
  namespace: "{{ helpdesk_namespace }}"
data:
  entrypoint.sh: |
    #!/bin/sh
    # Copy logos and favicon into assets dir (writable, not a mount)
    mkdir -p /usr/src/trudesk/public/uploads/assets
    cp /scripts/topLogo.svg /usr/src/trudesk/public/uploads/assets/topLogo.svg
    cp /scripts/topLogo.svg /usr/src/trudesk/public/uploads/assets/topLogo.png
    cp /scripts/pageLogo.svg /usr/src/trudesk/public/uploads/assets/pageLogo.svg
    cp /scripts/favicon.svg /usr/src/trudesk/public/uploads/assets/favicon.svg
    # Copy rebuild script
    cp /scripts/rebuild-css.js /usr/src/trudesk/rebuild-css.js
    # Start the app in background
    bash /usr/src/trudesk/startup.sh &
    APP_PID=$!
    # Wait for app to start, then rebuild CSS
    sleep 20
    cd /usr/src/trudesk && node rebuild-css.js
    # Wait for the app process
    wait $APP_PID
  rebuild-css.js: |
    var db = require('./src/database');
    db.init(function(err) {
      if (err) { console.error('DB error:', err); process.exit(1); }
      require('./src/sass/buildsass').build(function(e) {
        if (e) { console.error('Build error:', e); process.exit(1); }
        console.log('CSS rebuilt with custom colors');
        process.exit(0);
      });
    });
  topLogo.svg: |
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 140 50">
      <defs>
        <clipPath id="globe-clip-top">
          <circle cx="16" cy="25" r="15"/>
        </clipPath>
      </defs>
      <circle cx="16" cy="25" r="15" fill="none" stroke="#FFFFFF" stroke-width="2"/>
      <g clip-path="url(#globe-clip-top)" fill="none" stroke="#FFFFFF" stroke-width="1.2">
        <ellipse cx="16" cy="25" rx="15" ry="15"/>
        <ellipse cx="16" cy="25" rx="9" ry="15"/>
        <ellipse cx="16" cy="25" rx="3.5" ry="15"/>
        <ellipse cx="16" cy="17" rx="15" ry="4"/>
        <ellipse cx="16" cy="25" rx="15" ry="0.5"/>
        <ellipse cx="16" cy="33" rx="15" ry="4"/>
      </g>
      <text x="38" y="26" font-family="Arial,Helvetica,sans-serif" font-size="24" font-weight="bold" fill="#FFFFFF">GLOBEX</text>
      <text x="38" y="42" font-family="Arial,Helvetica,sans-serif" font-size="11" fill="rgba(255,255,255,0.7)" letter-spacing="3">HELPDESK</text>
    </svg>
  pageLogo.svg: |
    <svg xmlns="http://www.w3.org/2000/svg" width="300" height="100" viewBox="0 0 300 100">
      <defs>
        <clipPath id="gc">
          <circle cx="28" cy="28" r="24"/>
        </clipPath>
      </defs>
      <g transform="translate(20, 5)">
        <circle cx="28" cy="28" r="24" fill="none" stroke="#8B0000" stroke-width="2.5"/>
        <g clip-path="url(#gc)" fill="none" stroke="#8B0000" stroke-width="1.4">
          <ellipse cx="28" cy="28" rx="24" ry="24"/>
          <ellipse cx="28" cy="28" rx="15" ry="24"/>
          <ellipse cx="28" cy="28" rx="5.5" ry="24"/>
          <ellipse cx="28" cy="16" rx="24" ry="5"/>
          <ellipse cx="28" cy="28" rx="24" ry="0.5"/>
          <ellipse cx="28" cy="40" rx="24" ry="5"/>
        </g>
        <text x="61" y="39" font-family="Arial,Helvetica,sans-serif" font-size="44" font-weight="bold" fill="#8B0000">GLOBEX</text>
        <text x="61" y="72" font-family="Arial,Helvetica,sans-serif" font-size="20" fill="#555555" letter-spacing="4">HELPDESK</text>
      </g>
    </svg>
  favicon.svg: |
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
      <rect width="32" height="32" rx="4" fill="#8B0000"/>
      <text x="16" y="24" font-family="Arial,Helvetica,sans-serif" font-size="24" font-weight="bold" fill="#FFFFFF" text-anchor="middle">G</text>
    </svg>

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: helpdesk
  namespace: "{{ helpdesk_namespace }}"
  labels:
    app: helpdesk
spec:
  replicas: 1
  selector:
    matchLabels:
      app: helpdesk
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: helpdesk
    spec:
      containers:
        - name: helpdesk
          image: polonel/trudesk:1.2.11
          resources:
            requests:
              memory: "512Mi"
              cpu: "250m"
            limits:
              memory: "1Gi"
              cpu: "1000m"
          ports:
            - containerPort: 8118
              protocol: TCP
          env:
            - name: NODE_ENV
              value: production
            - name: TRUDESK_DOCKER
              value: "true"
            - name: TD_MONGODB_SERVER
              value: helpdesk-db
            - name: TD_MONGODB_PORT
              value: "27017"
            - name: TD_MONGODB_USERNAME
              value: "{{ helpdesk_db_user }}"
            - name: TD_MONGODB_PASSWORD
              value: "{{ helpdesk_db_password }}"
            - name: TD_MONGODB_DATABASE
              value: "{{ helpdesk_db_name }}"
          command: ["/bin/sh", "-c"]
          args: ["sh /scripts/entrypoint.sh"]
          volumeMounts:
            - name: scripts
              mountPath: /scripts
              readOnly: true
      volumes:
        - name: scripts
          configMap:
            name: helpdesk-scripts
            defaultMode: 0755

---
apiVersion: v1
kind: Service
metadata:
  name: helpdesk
  namespace: "{{ helpdesk_namespace }}"
  labels:
    app: helpdesk
spec:
  ports:
    - name: http
      port: 8118
      protocol: TCP
      targetPort: 8118
  selector:
    app: helpdesk
  type: ClusterIP

---
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: helpdesk
  namespace: "{{ helpdesk_namespace }}"
  labels:
    app: helpdesk
spec:
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Redirect
  to:
    kind: Service
    name: helpdesk
    weight: 100
  port:
    targetPort: http
