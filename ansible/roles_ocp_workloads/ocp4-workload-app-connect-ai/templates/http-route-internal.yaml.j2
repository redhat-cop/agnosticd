---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ai-proxy-route
  namespace: {{ __user }}-devspaces
spec:
  parentRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: internal-ai-gateway
      namespace: ai-gateway
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /{{ __user }}/
      filters:
        - type: URLRewrite
          urlRewrite:
            path:
              type: ReplacePrefixMatch
              replacePrefixMatch: /
        - type: RequestHeaderModifier
          requestHeaderModifier:
            set:
              - name: Host
                value: "{{ litellm_api_endpoint | regex_replace('https?://', '') | regex_replace('/.*', '') }}"
      backendRefs:
        - name: ai-api-external
          namespace: llm-api
          port: 443
