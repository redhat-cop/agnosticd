---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: helpdesk-db
  namespace: "{{ helpdesk_namespace }}"
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: helpdesk-db
  namespace: "{{ helpdesk_namespace }}"
  labels:
    app: helpdesk-db
spec:
  replicas: 1
  selector:
    matchLabels:
      app: helpdesk-db
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: helpdesk-db
    spec:
      initContainers:
        - name: init-permissions
          image: registry.redhat.io/rhscl/mongodb-36-rhel7:latest
          command: ["bash", "-c", "mkdir -p /var/lib/mongodb/data/db && chmod 777 /var/lib/mongodb/data/db"]
          securityContext:
            runAsUser: 0
          volumeMounts:
            - name: helpdesk-db-data
              mountPath: /var/lib/mongodb/data
      containers:
        - name: mongodb
          image: registry.redhat.io/rhscl/mongodb-36-rhel7:latest
          resources:
            requests:
              memory: "256Mi"
              cpu: "250m"
            limits:
              memory: "512Mi"
              cpu: "500m"
          ports:
            - containerPort: 27017
              protocol: TCP
          env:
            - name: MONGODB_ADMIN_PASSWORD
              value: "{{ helpdesk_db_admin_password }}"
            - name: MONGODB_USER
              value: "{{ helpdesk_db_user }}"
            - name: MONGODB_PASSWORD
              value: "{{ helpdesk_db_password }}"
            - name: MONGODB_DATABASE
              value: "{{ helpdesk_db_name }}"
          readinessProbe:
            exec:
              command:
                - /bin/sh
                - '-i'
                - '-c'
                - mongo 127.0.0.1:27017/$MONGODB_DATABASE -u $MONGODB_USER -p $MONGODB_PASSWORD --eval="quit()"
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 5
          livenessProbe:
            exec:
              command:
                - /bin/sh
                - '-i'
                - '-c'
                - mongo 127.0.0.1:27017/$MONGODB_DATABASE -u $MONGODB_USER -p $MONGODB_PASSWORD --eval="quit()"
            initialDelaySeconds: 30
            periodSeconds: 10
            timeoutSeconds: 5
          volumeMounts:
            - name: helpdesk-db-data
              mountPath: /var/lib/mongodb/data
              subPath: db
      volumes:
        - name: helpdesk-db-data
          persistentVolumeClaim:
            claimName: helpdesk-db

---
apiVersion: v1
kind: Service
metadata:
  name: helpdesk-db
  namespace: "{{ helpdesk_namespace }}"
  labels:
    app: helpdesk-db
spec:
  ports:
    - name: mongo
      port: 27017
      protocol: TCP
      targetPort: 27017
  selector:
    app: helpdesk-db
  type: ClusterIP
