---
apiVersion: networking.istio.io/v1alpha3
kind: DestinationRule
metadata:
  name: ai-origination
  namespace: llm-api
spec:
  host: "{{ litellm_api_endpoint | regex_replace('https?://', '') | regex_replace('/.*', '') }}"
  exportTo: ["*"]
  trafficPolicy:
    tls:
      mode: SIMPLE
      sni: "{{ litellm_api_endpoint | regex_replace('https?://', '') | regex_replace('/.*', '') }}"
