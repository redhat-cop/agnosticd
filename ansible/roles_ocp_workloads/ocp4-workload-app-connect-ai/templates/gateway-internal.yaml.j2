---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: internal-gateway
  namespace: ai-gateway
  annotations:
    networking.istio.io/service-type: "ClusterIP"
spec:
  gatewayClassName: openshift-default
  listeners:
  - name: internal-http
    protocol: HTTP
    port: 80
    allowedRoutes:
      namespaces:
        from: All
