{% if ocp4_workload_virt_roadshow_fvmw_num_users | int > 1 %}
{%   for user_number in range(1, ocp4_workload_virt_roadshow_fvmw_num_users | int + 1) %}
---
apiVersion: v1
kind: Secret
metadata:
  name: vmware-credentials
  namespace: {{ ocp4_workload_virt_roadshow_fvmw_mtv_namespace_base }}{{ user_number}}
type: Opaque
stringData:
  user: "{{ ocp4_workload_virt_roadshow_fvmw_auth_user_base }}{{ user_number }}"
  password: "{{ ocp4_workload_virt_roadshow_fvmw_vcenter_user_password }}"
  thumbprint: "{{ _ocp4_workload_virt_roadshow_fvmw_vcenter_sha1 }}"
  insecureSkipVerify: "true"
  url: "https://{{ fvmw_hostname }}/sdk"
{%   endfor %}
{% else %}
---
apiVersion: v1
kind: Secret
metadata:
  name: vmware-credentials
  namespace: openshift-mtv
type: Opaque
stringData:
  user: "{{ ocp4_workload_virt_roadshow_fvmw_vcenter_user }}"
  password: "{{ ocp4_workload_virt_roadshow_fvmw_vcenter_user_password }}"
  thumbprint: "{{ _ocp4_workload_virt_roadshow_fvmw_vcenter_sha1 }}"
  insecureSkipVerify: "true"
  url: "https://{{ fvmw_hostname }}/sdk"
{% endif %}
