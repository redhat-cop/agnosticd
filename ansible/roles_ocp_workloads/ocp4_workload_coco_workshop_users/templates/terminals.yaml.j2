# One wetty terminal per workshop persona. Each pod SSHes to the bastion as
# the student user and only exports that persona's KUBECONFIG, so a tab is
# a plain interactive shell logged into the cluster as that persona.
#
# Args are built with to_json so values containing YAML special characters
# (passwords, paths) stay a single, literal argv element.
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ ocp4_workload_coco_workshop_users_terminal_namespace }}
  labels:
    app.kubernetes.io/part-of: showroom
{% for terminal in ocp4_workload_coco_workshop_users_terminals %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: terminal-{{ terminal.name }}
  namespace: {{ ocp4_workload_coco_workshop_users_terminal_namespace }}
  labels:
    app: terminal-{{ terminal.name }}
    app.kubernetes.io/part-of: showroom
spec:
  replicas: 1
  selector:
    matchLabels:
      app: terminal-{{ terminal.name }}
  template:
    metadata:
      labels:
        app: terminal-{{ terminal.name }}
        app.kubernetes.io/part-of: showroom
    spec:
      containers:
        - name: wetty
          image: {{ ocp4_workload_coco_workshop_users_terminal_image }}
          imagePullPolicy: IfNotPresent
          args:
            - --base=/
            - --port=3000
            - --allow-iframe=true
            - {{ ('--ssh-host=' ~ ocp4_workload_coco_workshop_users_terminal_bastion_host) | to_json }}
            - {{ ('--ssh-port=' ~ (ocp4_workload_coco_workshop_users_terminal_bastion_port | int)) | to_json }}
            - {{ ('--ssh-user=' ~ ocp4_workload_coco_workshop_users_terminal_bastion_user) | to_json }}
            - --ssh-auth=password
            - {{ ('--ssh-pass=' ~ ocp4_workload_coco_workshop_users_terminal_bastion_password) | to_json }}
            - {{ ('--command=export KUBECONFIG=' ~ terminal.kubeconfig
                  ~ '; cd ~/' ~ terminal.name ~ '; exec bash') | to_json }}
          ports:
            - name: http
              containerPort: 3000
              protocol: TCP
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 256Mi
---
apiVersion: v1
kind: Service
metadata:
  name: terminal-{{ terminal.name }}
  namespace: {{ ocp4_workload_coco_workshop_users_terminal_namespace }}
  labels:
    app: terminal-{{ terminal.name }}
spec:
  selector:
    app: terminal-{{ terminal.name }}
  ports:
    - name: http
      port: 80
      targetPort: http
---
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: terminal-{{ terminal.name }}
  namespace: {{ ocp4_workload_coco_workshop_users_terminal_namespace }}
  labels:
    app: terminal-{{ terminal.name }}
  annotations:
    # Web terminals are long-lived websockets; the default 30s router
    # timeout would drop them.
    haproxy.router.openshift.io/timeout: 3600s
spec:
  host: {{ ocp4_workload_coco_workshop_users_terminal_host_prefix }}-{{ ocp4_workload_coco_workshop_users_terminal_host_suffix }}-{{ terminal.name }}.{{ _coco_apps_domain }}
  to:
    kind: Service
    name: terminal-{{ terminal.name }}
    weight: 100
  port:
    targetPort: http
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Redirect
{% endfor %}
